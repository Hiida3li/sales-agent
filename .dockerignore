# Keep the build context small and the image clean.

# Version control / CI
.git
.github
.gitignore

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Local runtime artifacts (not needed in the image)
sessions/
state/

# Secrets and local config
.env

# Editor / OS noise
.idea/
.vscode/
.DS_Store

# Notebooks and host-only client
*.ipynb
.ipynb_checkpoints/
client/

# Docs and compose are not needed inside the image
DEPLOYMENT.md
docker-compose*.yml
Makefile
run.sh
