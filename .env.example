# Copy this file to .env and fill in the values.
# Only GOOGLE_API_KEY is required; the rest have sensible defaults.

# --- Required ---------------------------------------------------------------
# Your Google Gemini API key. Used by the agent service.
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Kafka ------------------------------------------------------------------
# Broker address. For the host-side CLI client use localhost:9092.
# Inside Docker, docker-compose overrides this to kafka:29092, so this value
# only affects processes you run directly on the host.
KAFKA_BROKER=localhost:9092

# --- Model / loop tuning (defaults shown) -----------------------------------
GEMINI_MODEL=gemini-2.5-flash
MAX_INTERACTIONS=10
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=10000
